{
  "name": "prasun1111",
  "version": "0.0.3",
  "private": true,
  "scripts": {
    "dev": "TINA_LOCAL=true tinacms dev -c \"next dev --turbopack\"",
    "build": "tinacms build && rm -f \"tina/__generated__/client.ts\" && next build",
    "build-local": "bash scripts/tina-local-build.sh",
    "build:netlify": "NODE_OPTIONS=--max-old-space-size=4096 pnpm run build",
    "start": "tinacms build && rm -f \"tina/__generated__/client.ts\" && next start",
    "export": "npm run build && next export",
    "lint": "biome lint",
    "dev:build": "next build",
    "pages:dev": "pnpm build-local && npx wrangler@3 pages dev out",
    "d1:migrate:local": "npx wrangler@3 d1 migrations apply prasun1111-comments --local",
    "d1:migrate:remote": "npx wrangler@3 d1 migrations apply prasun1111-comments --remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@svgr/webpack": "^8.1.0",
    "@tinacms/cli": "^2.4.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.18.12",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.34",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/postcss": "^4.1.15",
    "@tailwindcss/typography": "^0.5.19",
    "@tinacms/auth": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "cloudinary-video-player": "^4.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.484.0",
    "mermaid": "^11.12.0",
    "motion": "^12.23.24",
    "next": "15.3.8",
    "next-themes": "^0.4.6",
    "next-tinacms-cloudinary": "^24.0.5",
    "nextjs-toploader": "^3.9.17",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-player": "^2.16.1",
    "react-use-measure": "^2.1.7",
    "serverless-http": "^4.0.0",
    "shiki": "^3.13.0",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.15",
    "tinacms": "^3.9.0",
    "tw-animate-css": "^1.4.0",
    "usehooks-ts": "^3.1.1"
  }
}
